# Server & Runtime
NODE_ENV=development
PORT=3000
APP_ORIGIN=https://cohost.web.app

# Google Cloud / Vertex AI (Cloud Run uses ADC service account automatically)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL_ID=gemini-3.8-flash

# Host Allowlist (comma-separated verified Google emails)
ALLOWED_HOST_EMAILS=host@example.com,cohost@example.com

# Workspace Gmail Ingestion (Internal OAuth refresh token stored in Secret Manager)
GMAIL_WATCHED_EMAIL=cohost@yourdomain.com
GMAIL_WATCHED_LABEL=Co-Host
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/cohost-gmail-push
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# OIDC Verification for Cloud Pub/Sub & Cloud Scheduler Internal Endpoints
INTERNAL_OIDC_AUDIENCE=https://cohost-xxxxxxxx-uc.a.run.app
PUBSUB_PUSH_SERVICE_ACCOUNT=cohost-pubsub-push@your-gcp-project-id.iam.gserviceaccount.com
SCHEDULER_SERVICE_ACCOUNT=cohost-scheduler@your-gcp-project-id.iam.gserviceaccount.com

# Firebase Client SDK (public web config; omit locally to use offline dev seed mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
