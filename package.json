    "express": "^4.21.2",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "google-auth-library": "^9.15.1",
    "lucide-react": "^0.546.0",
    "multer": "^1.4.5-lts.2",
    "postal-mime": "^2.4.12",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
